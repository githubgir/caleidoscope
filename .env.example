# Caleidoscope Environment Variables

# Optional: Anthropic API key for LLM-powered digest summaries
# If not set, digests will still work but without AI summaries
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: Override the database path (defaults to data/caleidoscope.db)
CALEIDOSCOPE_DB=data/caleidoscope.db
